{
  "$schema": "https://opencode.ai/config.json",
  "model": "ravenx/ravenx-chaos-agent-qwen3.8-27b",
  "provider": {
    "ravenx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RavenX Colab GPU",
      "options": {
        "baseURL": "{env:RAVENX_BASE_URL}",
        "apiKey": "{env:RAVENX_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "ravenx-chaos-agent-qwen3.8-27b": {
          "name": "RavenX Chaos Agent Qwen3.8 27B",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    }
  }
}
